# Full connection string for the PostgreSQL database.
# For production/Docker, use the service name: postgresql://pxlcensor:devpassword@postgres:5432/pxlcensor
DATABASE_URL=postgresql://pxlcensor:devpassword@localhost:5432/pxlcensor

# Full internal URL for the media service.
# For production/Docker, use the service name: http://media:8081
MEDIA_SERVICE_URL=http://localhost:8081

# Must be the same secret as the API and Media services.
MEDIA_SIGNING_SECRET=dev-secret-change-in-production

# Number of jobs this worker can process at the same time.
PROCESSOR_CONCURRENCY=1

# Directory for temporary file downloads.
TEMP_DIR=/tmp/pxlcensor