# Service URLs
# ------------------
# Full public URL of the API service. If running behind a reverse proxy with HTTPS,
# this should be the public HTTPS address (e.g., https://api.yourdomain.com).
# This is used to derive other external URLs.
# API_EXTERNAL_URL=

# Full internal URL of the Media service, used for service-to-service communication.
# In Docker, this would typically be http://media:8081.
MEDIA_SERVICE_URL=http://localhost:8081

# Full public URL for accessing media files.
# If not set, this is derived from API_EXTERNAL_URL.
# Use this if your media service is on a different public domain or CDN.
# MEDIA_EXTERNAL_URL=

# Database
# --------
POSTGRES_PASSWORD=devpassword

# Security
# --------
MEDIA_SIGNING_SECRET=dev-secret-change-in-production
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Limits
# ------
MAX_UPLOAD_MB=25
PROCESSOR_CONCURRENCY=1

# Development
# -----------
NODE_ENV=development
LOG_LEVEL=info
