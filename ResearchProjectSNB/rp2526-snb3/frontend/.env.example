# This file is for documenting environment variables required by the frontend.
# A .env file can be created in this directory to override these during development.

# The base URL for API requests in production builds.
# In development, the Vite proxy is used (see vite.config.js), so this is optional.
# For example:
# VITE_API_BASE_URL=https://api.yourdomain.com/api
